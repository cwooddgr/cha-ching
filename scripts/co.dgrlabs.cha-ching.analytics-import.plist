<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily import of Apple's App Sessions analytics (active devices) into
  cha-ching's D1 — the data behind the dashboard's ACTIVE DEVICES panel.

  Install:
    cp scripts/co.dgrlabs.cha-ching.analytics-import.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/co.dgrlabs.cha-ching.analytics-import.plist
  Run it now:
    launchctl kickstart -k gui/$(id -u)/co.dgrlabs.cha-ching.analytics-import
  Log: ~/Library/Logs/cha-ching-analytics-import.log

  Runs on this Mac for the same reason the sales import does: the Finance-role
  App Store Connect key stays here (see the sales-import plist). The importer
  skips instances already held, so a run missed while the Mac is asleep is
  made up by the next one, and Apple keeps every instance it has published.

  DAILY, twice: Apple has not said when in the day a new instance appears, and
  the importer is idempotent, so it runs at 10:00 and 18:00 local — whichever
  one lands after Apple does the work, the other is a no-op. launchd runs a
  missed calendar job once on wake.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>co.dgrlabs.cha-ching.analytics-import</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>scripts/analytics-import.mjs</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/cwood/projects/cha-ching</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>15</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>18</integer>
			<key>Minute</key>
			<integer>15</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/cwood/Library/Logs/cha-ching-analytics-import.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/cwood/Library/Logs/cha-ching-analytics-import.log</string>
</dict>
</plist>
